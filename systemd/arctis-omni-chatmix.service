[Unit]
Description=Arctis Nova Pro Omni ChatMix dial -> PipeWire Game/Chat sinks
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire-pulse.service
# PipeWire recreates the Game/Chat sinks at 100% on restart; restarting with it re-applies the dial.
PartOf=pipewire.service

[Service]
ExecStart=%h/.local/bin/arctis-omni chatmix-daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
