#!/usr/bin/env python3
"""Control SteelSeries Arctis Nova Pro Omni / Nova Pro Wireless / Nova Pro (wired) over hidraw.

Protocol derived from SteelSeries GG's device definitions, for interoperability:
commands are 64-byte output reports on the usage-page 0xFFC0 collection (report ID 0x01
on the Omni, 0x06 on the Nova Pro models); the hubs push events as report ID 0x07 on the
same interface.
"""
import argparse
import fcntl
import glob
import json
import os
import select
import signal
import subprocess
import sys
import time

VENDOR = 0x1038
EVENT = 0x07

CMD_STATUS = 0xB0
CMD_AUDIO_SETTINGS = 0x20
CMD_ANC_LEVEL = 0xB8
CMD_TRANSPARENT_LEVEL = 0xB9
CMD_ANC_MODE = 0xBD
CMD_SOFTWARE_CHATMIX = 0x49
CMD_SONAR_PRESENT = 0x8D
EV_CHATMIX = 0x45

ANC_MODES = {"off": 0, "transparency": 1, "anc": 2}
GAME_SINK = "arctis_omni_game"
CHAT_SINK = "arctis_omni_chat"
LOOPBACK_OUTPUTS = ("arctis_omni_game_out", "arctis_omni_chat_out")


class Omni:
    name = "Arctis Nova Pro Omni"
    pids = (0x2290,)
    report = 0x01
    wireless = True  # has the B0 battery/link/noise-mode status
    battery_steps = 100  # status bytes are already percentages
    anc_writable = True
    anc_level_supported = True
    sidetone_max = 10

    def settings(self, hub):
        # The settings block is a 1036-byte feature report, fetched after a 0x20 request.
        hub.send(CMD_AUDIO_SETTINGS)
        time.sleep(0.1)
        size = 1037
        buf = bytearray(size)
        buf[0] = self.report
        fcntl.ioctl(hub.fd, (3 << 30) | (size << 16) | (ord("H") << 8) | 0x07, buf)  # HIDIOCGFEATURE
        # Layout: command, 2x10 EQ bands of 6 bytes, 10 BT + 10 mic gains, then settings.
        b = 1 + 60 + 60 + 20
        return {
            "mic_volume": buf[b + 4],
            "sidetone_level": buf[b + 5],
            "sidetone_on": bool(buf[b + 28]),
            "chatmix_game": buf[b + 10],
            "chatmix_chat": buf[b + 11],
        }

    def set_sidetone(self, hub, level, current):
        # Separate on/off flag; turning it off keeps the stored level.
        if level == 0:
            hub.send(0x38, 0, current["sidetone_level"])
        else:
            hub.send(0x38, 1, level)

    def default_sidetone(self, current):
        return current["sidetone_level"]


class NovaProWireless:
    name = "Arctis Nova Pro Wireless"
    pids = (0x12E0, 0x12E5, 0x225D)  # PC, Xbox, Xbox white base stations
    report = 0x06
    wireless = True
    battery_steps = 8  # status bytes are 0-8 (12.5% steps)
    # GG only reads the noise mode on this model, but the hub accepts the Omni's 0xBD
    # (mode) and 0xB9 (transparency level) commands, verified on hardware. There's no
    # ANC strength in its status, so 0xB8 is left out.
    anc_writable = True
    anc_level_supported = False
    sidetone_max = 3

    def settings(self, hub):
        s = hub.query(CMD_AUDIO_SETTINGS)
        return {
            "mic_volume": s[17],
            "sidetone_level": s[18],
            "sidetone_on": s[18] > 0,
            "chatmix_game": s[20],
            "chatmix_chat": s[21],
        }

    def set_sidetone(self, hub, level, _current):
        hub.send(0x39, level)  # 0 off, 1 low, 2 medium, 3 high

    def default_sidetone(self, _current):
        return 2


class NovaProWired(NovaProWireless):
    # GameDAC Gen 2: same report ID, settings reply, sidetone and ChatMix as the Nova Pro
    # Wireless, but a wired headset has no battery/link status and no ANC.
    name = "Arctis Nova Pro"
    pids = (0x12CB, 0x12CD)  # PC, Xbox GameDACs
    wireless = False
    anc_writable = False


MODELS = (Omni(), NovaProWireless(), NovaProWired())


def find_hub():
    # Each hub has a hidraw node whose report descriptor starts with Usage Page 0xFFC0
    # (06 C0 FF); that node also carries the 0x07 event collection.
    for node in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        try:
            with open(f"{node}/device/uevent") as f:
                hid_id = next(l.split("=", 1)[1] for l in f.read().splitlines() if l.startswith("HID_ID="))
            _bus, vid, pid = (int(x, 16) for x in hid_id.split(":"))
            model = next((m for m in MODELS if vid == VENDOR and pid in m.pids), None)
            if not model:
                continue
            with open(f"{node}/device/report_descriptor", "rb") as f:
                if f.read(3) == b"\x06\xc0\xff":
                    return "/dev/" + os.path.basename(node), model, usb_product(node)
        except (OSError, StopIteration, ValueError):
            continue
    return None


def usb_product(hidraw_node):
    # Walk up from the HID device to the USB device, which holds the product string
    # that PipeWire's ALSA sink name is built from.
    path = os.path.realpath(f"{hidraw_node}/device")
    while path != "/":
        try:
            with open(f"{path}/product") as f:
                return f.read().strip()
        except OSError:
            path = os.path.dirname(path)
    return None


class Hub:
    def __init__(self):
        found = find_hub()
        if not found:
            sys.exit("No supported SteelSeries base station found "
                     "(Arctis Nova Pro Omni, Nova Pro Wireless or Nova Pro)")
        self.path, self.model, self.product = found
        try:
            self.fd = os.open(self.path, os.O_RDWR)
        except PermissionError:
            sys.exit(f"No permission to open {self.path} ({self.model.name}); "
                     "install the udev rule (./install.sh) and replug the device")

    def send(self, *payload):
        os.write(self.fd, bytes([self.model.report, *payload]) + bytes(63 - len(payload)))

    def read(self, timeout):
        if not select.select([self.fd], [], [], timeout)[0]:
            return None
        return os.read(self.fd, 64)

    def query(self, cmd, attempts=3):
        # Event reports are interleaved on the same collection, so skip until our reply.
        for _ in range(attempts):
            self.send(cmd)
            deadline = time.time() + 2
            while time.time() < deadline:
                d = self.read(deadline - time.time())
                if d and d[0] == self.model.report and d[1] == cmd:
                    return d
        sys.exit(f"no reply to command {cmd:#04x}")

    def settings(self):
        return self.model.settings(self)


def cmd_status(hub, args):
    m = hub.model
    a = hub.settings()
    if m.wireless:
        s = hub.query(CMD_STATUS)
        mode = {v: k for k, v in ANC_MODES.items()}.get(s[10], s[10])
        st = {
            "connected": s[14] == 0x08,
            "battery": s[6] * 100 // m.battery_steps,
            "charger_battery": s[7] * 100 // m.battery_steps,
            "charging": s[15] == 0x02,
            "noise_mode": mode,
            "anc_level": s[16] if m.anc_level_supported else None,
            "transparency_level": s[8],
            "mic_muted": bool(s[9]),
        }
    else:
        # Wired: the headset is there whenever the GameDAC is; nothing to report on
        # battery, noise mode or mute.
        st = dict.fromkeys(("battery", "charger_battery", "charging", "noise_mode", "anc_level",
                            "transparency_level", "mic_muted"))
        st["connected"] = True
    if args.json:
        print(json.dumps({
            "model": m.name,
            "wireless": m.wireless,
            **st,
            "anc_writable": m.anc_writable,
            "sidetone_on": a["sidetone_on"],
            "sidetone_level": a["sidetone_level"],
            "sidetone_max": m.sidetone_max,
            "mic_volume": a["mic_volume"],
            "chatmix_game": a["chatmix_game"],
            "chatmix_chat": a["chatmix_chat"],
        }))
        return
    print(f"model:        {m.name}")
    if m.wireless:
        print(f"headset:      {'connected' if st['connected'] else 'not connected'}")
        if st["connected"]:
            print(f"battery:      {st['battery']}%")
        print(f"spare:        {st['charger_battery']}%")
        levels = f"ANC level {st['anc_level']}/3, " if st["anc_level"] is not None else ""
        note = "" if m.anc_writable else "; change it on the headset"
        print(f"noise mode:   {st['noise_mode']}  ({levels}transparency level {st['transparency_level']}/10{note})")
    else:
        print("headset:      wired")
    sidetone = f"on, level {a['sidetone_level']}/{m.sidetone_max}" if a["sidetone_on"] else "off"
    print(f"sidetone:     {sidetone}")
    muted = "" if st["mic_muted"] is None else ", muted" if st["mic_muted"] else ", unmuted"
    print(f"mic:          volume {a['mic_volume']}/10{muted}")
    print(f"chatmix dial: game {a['chatmix_game']}%, chat {a['chatmix_chat']}%")


def require_anc(hub):
    if not hub.model.anc_writable:
        sys.exit(f"The {hub.model.name} has no noise cancelling or transparency mode")


def cmd_anc(hub, args):
    require_anc(hub)
    hub.send(CMD_ANC_MODE, ANC_MODES[args.mode])


def cmd_anc_level(hub, args):
    require_anc(hub)
    if not hub.model.anc_level_supported:
        sys.exit(f"The {hub.model.name} doesn't have an adjustable ANC strength")
    hub.send(CMD_ANC_LEVEL, args.level)


def cmd_transparency_level(hub, args):
    require_anc(hub)
    hub.send(CMD_TRANSPARENT_LEVEL, args.level)


def cmd_sidetone(hub, args):
    m = hub.model
    current = hub.settings()
    if args.value == "off":
        level = 0
    elif args.value == "on":
        level = m.default_sidetone(current) or 1
    else:
        level = int(args.value) if args.value.isdigit() else 0
        if not 1 <= level <= m.sidetone_max:
            sys.exit(f"sidetone level must be 1-{m.sidetone_max}, on or off for the {m.name}")
    m.set_sidetone(hub, level, current)


def set_volume(sink, percent):
    result = subprocess.run(["pactl", "set-sink-volume", sink, f"{percent}%"],
                            check=False, capture_output=True)
    return result.returncode == 0


def route_outputs(product):
    # Point the Game/Chat loopbacks at this headset's ALSA sink via PipeWire's routing
    # metadata, so the same sinks follow whichever base station is connected.
    if not product:
        return False
    try:
        sinks = subprocess.run(["pactl", "list", "short", "sinks"], check=True,
                               capture_output=True, text=True).stdout
        dump = json.loads(subprocess.run(["pw-dump"], check=True, capture_output=True,
                                         text=True).stdout)
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError):
        return False
    # The trailing "-" keeps "Arctis Nova Pro" from matching "Arctis Nova Pro Wireless/Omni".
    prefix = "alsa_output.usb-SteelSeries_" + product.replace(" ", "_") + "-"
    target = next((line.split("\t")[1] for line in sinks.splitlines()
                   if line.split("\t")[1:2] and line.split("\t")[1].startswith(prefix)), None)
    if not target:
        return False
    ids = {o["info"]["props"].get("node.name"): o["id"] for o in dump
           if o.get("type") == "PipeWire:Interface:Node" and o.get("info")}
    if not all(name in ids for name in LOOPBACK_OUTPUTS):
        return False
    for name in LOOPBACK_OUTPUTS:
        result = subprocess.run(["pw-metadata", "-n", "default", str(ids[name]), "target.object", target],
                                check=False, capture_output=True)
        if result.returncode != 0:
            return False
    return True


def cmd_chatmix_daemon(_hub, _args):
    # Puts the hub in software-ChatMix mode and tells it a mixer ("Sonar") is present, as
    # GG does while Sonar runs, then mirrors the dial onto the Game/Chat loopback sinks.
    # Reconnects if the hub goes away; clears both flags on exit, as GG does on shutdown.
    stop = False

    def on_signal(*_):
        nonlocal stop
        stop = True

    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)
    while not stop:
        if not find_hub():
            time.sleep(3)
            continue
        hub = None
        try:
            hub = Hub()
            hub.send(CMD_SONAR_PRESENT, 1)
            hub.send(CMD_SOFTWARE_CHATMIX, 1)
            a = hub.settings()
            mix = (a["chatmix_game"], a["chatmix_chat"])
            print(f"chatmix active on {hub.path} ({hub.model.name}): "
                  f"game {mix[0]}% chat {mix[1]}%", flush=True)
            # Routing and volumes are retried every second until they succeed (sinks not
            # up yet, PipeWire restarting).
            routed = applied = False
            while not stop:
                if not routed:
                    routed = route_outputs(hub.product)
                    if routed:
                        print(f"game/chat outputs routed to {hub.product}", flush=True)
                if not applied:
                    applied = set_volume(GAME_SINK, mix[0]) & set_volume(CHAT_SINK, mix[1])
                d = hub.read(1.0)
                if d and d[0] == EVENT and d[1] == EV_CHATMIX:
                    mix = (d[2], d[3])
                    applied = False
        except OSError as e:
            print(f"hub lost ({e}), waiting for it to come back", flush=True)
            time.sleep(3)
        finally:
            if hub:
                try:
                    hub.send(CMD_SOFTWARE_CHATMIX, 0)
                    hub.send(CMD_SONAR_PRESENT, 0)
                except OSError:
                    pass
                os.close(hub.fd)


def main():
    p = argparse.ArgumentParser(prog="arctis-omni", description=__doc__.splitlines()[0])
    sub = p.add_subparsers(dest="command", required=True)
    s = sub.add_parser("status", help="battery, noise mode, sidetone and ChatMix state")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_status)
    s = sub.add_parser("anc", help="noise mode")
    s.add_argument("mode", choices=ANC_MODES)
    s.set_defaults(func=cmd_anc)
    s = sub.add_parser("anc-level", help="ANC strength 1-3 (Omni only)")
    s.add_argument("level", type=int, choices=range(1, 4))
    s.set_defaults(func=cmd_anc_level)
    s = sub.add_parser("transparency-level", help="transparency strength 1-10")
    s.add_argument("level", type=int, choices=range(1, 11))
    s.set_defaults(func=cmd_transparency_level)
    s = sub.add_parser("sidetone", help="on, off, or a level (Omni 1-10, Nova Pro Wireless 1-3)")
    s.add_argument("value")
    s.set_defaults(func=cmd_sidetone)
    sub.add_parser("chatmix-daemon", help="run the ChatMix dial service").set_defaults(func=cmd_chatmix_daemon)
    args = p.parse_args()
    args.func(None if args.command == "chatmix-daemon" else Hub(), args)


if __name__ == "__main__":
    main()
