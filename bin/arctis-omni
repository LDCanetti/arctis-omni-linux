#!/usr/bin/env python3
"""Control SteelSeries Arctis Nova Pro Omni / Nova Pro Wireless / Nova Pro (wired) over hidraw.

Protocol derived from SteelSeries GG's device definitions, for interoperability:
commands are 64-byte output reports on the usage-page 0xFFC0 collection (report ID 0x01
on the Omni, 0x06 on the Nova Pro models); the hubs push events as report ID 0x07 on the
same interface.
"""
import argparse
import fcntl
import glob
import hashlib
import json
import os
import re
import select
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import urllib.parse
import urllib.request
import zlib

VERSION = "0.3.0"
VENDOR = 0x1038
EVENT = 0x07

CMD_STATUS = 0xB0
CMD_AUDIO_SETTINGS = 0x20
CMD_ANC_LEVEL = 0xB8
CMD_TRANSPARENT_LEVEL = 0xB9
CMD_ANC_MODE = 0xBD
CMD_MIC_VOLUME = 0x37
CMD_SOFTWARE_CHATMIX = 0x49
CMD_SONAR_PRESENT = 0x8D
# GG waits this long after a hub appears before talking to it ("init-sleep-length").
HUB_INIT_SECONDS = 5
EV_CHATMIX = 0x45

ANC_MODES = {"off": 0, "transparency": 1, "anc": 2}
GAME_SINK = "arctis_omni_game"
CHAT_SINK = "arctis_omni_chat"
LOOPBACK_OUTPUTS = ("arctis_omni_game_out", "arctis_omni_chat_out")
# Where Game/Chat play when not on the headset: a sink name, set with `arctis-omni output`.
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
                         "arctis-omni")
OUTPUT_STATE = os.path.join(STATE_DIR, "output")
FIRMWARE_STATE = os.path.join(STATE_DIR, "firmware.json")
# Held while firmware is being written; other commands leave the device alone meanwhile.
FLASH_LOCK = os.path.join(STATE_DIR, "flashing")
CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
                         "arctis-omni")
# SteelSeries ships firmware only inside GG. This is GG's own updater endpoint. The public download link sits behind a Cloudflare browser
# challenge; this API doesn't. It answers with the next release after current_version
# (old versions step through intermediate releases) and an empty body when up to date.
GG_CHECK_URL = "https://steelseries.com/api/v2/releases/gg/check-version"
GG_BASELINE = "100.0.0"
# Bumped when the set of cached firmware folders changes, so older caches get rebuilt.
CACHE_FORMAT = "2"


class Omni:
    name = "Arctis Nova Pro Omni"
    pids = (0x2290,)
    report = 0x01
    wireless = True  # has the B0 battery/link/noise-mode status
    battery_steps = 100  # status bytes are already percentages
    anc_writable = True
    anc_level_supported = True
    sidetone_max = 10

    def settings(self, hub):
        # The settings block is a 1036-byte feature report, fetched after a 0x20 request.
        hub.send(CMD_AUDIO_SETTINGS)
        time.sleep(0.1)
        size = 1037
        buf = bytearray(size)
        buf[0] = self.report
        fcntl.ioctl(hub.fd, (3 << 30) | (size << 16) | (ord("H") << 8) | 0x07, buf)  # HIDIOCGFEATURE
        # Layout: command, 2x10 EQ bands of 6 bytes, 10 BT + 10 mic gains, then settings.
        b = 1 + 60 + 60 + 20
        return {
            "mic_volume": buf[b + 4],
            "sidetone_level": buf[b + 5],
            "sidetone_on": bool(buf[b + 28]),
            "chatmix_game": buf[b + 10],
            "chatmix_chat": buf[b + 11],
        }

    def set_sidetone(self, hub, level, current):
        # Separate on/off flag; turning it off keeps the stored level.
        if level == 0:
            hub.send(0x38, 0, current["sidetone_level"])
        else:
            hub.send(0x38, 1, level)

    def default_sidetone(self, current):
        return current["sidetone_level"]

    # Firmware: chips in the 0x10 reply (12-byte fields), and where GG keeps their files
    # ({GG firmware folder PID: chips in its version.json order}).
    fw_chips = ("base MCU 1", "base MCU 2", "base DSP", "headset MCU", "headset Bluetooth")
    fw_bundles = {0x2290: {0x2290: ("base MCU 1", "base MCU 2", "base DSP"),
                           0x2296: ("headset MCU", "headset Bluetooth")}}
    flashable = ()
    update_hint = ("Update with SteelSeries GG on Windows. Its updater only starts with the "
                   "GameHub and the headset both connected to the PC by USB cable.")


class NovaProWireless:
    name = "Arctis Nova Pro Wireless"
    pids = (0x12E0, 0x12E5, 0x225D)  # PC, Xbox, Xbox white base stations
    report = 0x06
    wireless = True
    battery_steps = 8  # status bytes are 0-8 (12.5% steps)
    # GG only reads the noise mode on this model, but the hub accepts the Omni's 0xBD
    # (mode) and 0xB9 (transparency level) commands, verified on hardware. There's no
    # ANC strength in its status, so 0xB8 is left out.
    anc_writable = True
    anc_level_supported = False
    sidetone_max = 3

    def settings(self, hub):
        s = hub.query(CMD_AUDIO_SETTINGS)
        return {
            "mic_volume": s[17],
            "sidetone_level": s[18],
            "sidetone_on": s[18] > 0,
            "chatmix_game": s[20],
            "chatmix_chat": s[21],
        }

    def set_sidetone(self, hub, level, _current):
        hub.send(0x39, level)  # 0 off, 1 low, 2 medium, 3 high

    def default_sidetone(self, _current):
        return 2

    fw_chips = ("base DSP", "base MCU", "headset MCU", "headset Bluetooth")
    fw_bundles = {pid: {pid: ("base DSP", "base MCU"), rx: ("headset MCU", "headset Bluetooth")}
                  for pid, rx in ((0x12E0, 0x12E2), (0x12E5, 0x12E8), (0x225D, 0x2260))}
    # Newer "v2" headsets for the PC and Xbox base stations have their own firmware line
    # (2.x). GG lists both targets for these base stations; the headset's MCU major
    # version tells which one is paired.
    fw_v2_headset = {0x12E0: 0x2240, 0x12E5: 0x2242}
    fw_flash_order = ("base DSP", "base MCU", "headset MCU", "headset Bluetooth")
    # Flashing is verified on the Xbox base station with a v2 headset only.
    flashable = (0x12E5,)
    update_hint = ("Update with SteelSeries GG on Windows, with the base station connected "
                   "to the PC by USB.")

    @staticmethod
    def part_name(pid):
        return "base station" if pid in NPW_BASE_PIDS else "headset"

    def recovery_version(self, cache, pid, chip):
        chips = self.fw_flash_order[:2] if pid in NPW_BASE_PIDS else self.fw_flash_order[2:]
        return folder_versions(bundle_folder(cache, pid), chips).get(chip)

    @staticmethod
    def flash_problem(jobs):
        for pid in {job.pid for job in jobs}:
            if pid in NPW_BASE_PIDS:
                found = len(npw_base_nodes())
                if found != 1:
                    return f"Connect exactly one Arctis Nova Pro Wireless base station while updating (found {found})."
            elif len(npw_headset_nodes(pid)) != 1:
                return "Connect the headset (only one) to this PC with its USB cable."
        return None

    @staticmethod
    def flash_ready(pid):
        return vendor_nodes(pid, 0x06 if pid in NPW_BASE_PIDS else 0x07)

    @staticmethod
    def prepare_update(device, chips):
        # The headset's own chips are updated over its USB cable.
        headset = [c for c in chips if c.startswith("headset")]
        if not headset:
            return chips
        pid = folder_pid(device.get("folders", {}).get(headset[0], "0"))
        while not npw_headset_nodes(pid):
            print("The headset is updated over its own USB cable: connect it to this PC with a USB")
            print("cable and switch it on (keep the base station connected too).")
            try:
                answer = input("Press Enter when it's connected, or type 'skip' to update only the base station: ")
            except (EOFError, KeyboardInterrupt):
                print()
                return []
            if answer.strip() == "skip":
                return [c for c in chips if c not in headset]
        return chips

    @staticmethod
    def flash_notes(chips):
        notes = ["Connect the base station to this PC directly with its USB cable (not through a USB hub)."]
        if any(c.startswith("headset") for c in chips):
            notes.append("Keep the headset switched on and connected by its USB cable.")
        notes.append("Don't unplug anything until it says it's finished (a few minutes).")
        if "base MCU" in chips or "headset MCU" in chips:
            notes.append("The base station and headset restart during the update; sound stops for a moment.")
        return notes

    @staticmethod
    def after_flash(jobs):
        # A headset on a USB cable doesn't link to its base station.
        if any(job.chip.startswith("headset") for job in jobs):
            say("\nUnplug the headset's USB cable now: it reconnects to the base station only without it.")
            pause("Press Enter when it's unplugged… ")
            deadline = time.time() + 30
            while time.time() < deadline:
                if not find_hub():
                    time.sleep(2)
                    continue
                hub = Hub()
                try:
                    if hub.query(CMD_STATUS)[14] == 0x08:
                        break
                finally:
                    hub.close()
                time.sleep(2)

    def flash_jobs(self, _cache, pid, chips, versions, folders):
        jobs = []
        for chip in self.fw_flash_order:
            if chip not in chips:
                continue
            folder, version = folders.get(chip), versions[chip]
            if not folder:
                raise RuntimeError("no firmware folder recorded; run 'arctis-omni firmware check'")
            target = pid if chip.startswith("base") else folder_pid(folder)
            if chip == "base DSP":
                pattern, run = "_dsp_", lambda d, p, t=target, c=chip: npw_flash_dsp(t, d, p, c)
            elif chip == "base MCU":
                pattern, run = "_mcu_", lambda d, p, t=target, c=chip: npw_flash_mcu(t, (0x06, 0xEB), d, p, c)
            elif chip == "headset MCU":
                pattern, run = "_mcu_", lambda d, p, t=target, c=chip: npw_flash_mcu(t, (0x07, 0x2C, 0xEF), d, p, c)
            else:
                pattern, run = "_bt_", lambda d, p, t=target, c=chip: npw_flash_qcc(t, d, p, c)
            jobs.append(FlashJob(chip, version, firmware_file(folder, pattern, version), target, run))
        return jobs


class NovaProWired(NovaProWireless):
    # GameDAC Gen 2: same report ID, settings reply, sidetone and ChatMix as the Nova Pro
    # Wireless, but a wired headset has no battery/link status and no ANC.
    name = "Arctis Nova Pro"
    pids = (0x12CB, 0x12CD)  # PC, Xbox GameDACs
    wireless = False
    anc_writable = False

    fw_chips = ("DSP", "MCU", "USB")
    fw_bundles = {pid: {pid: ("DSP", "MCU", "USB")} for pid in (0x12CB, 0x12CD)}
    fw_flash_order = ("USB", "DSP", "MCU")
    # Flashing is verified on the PC GameDAC only (all three chips, 2026-11-01).
    flashable = (0x12CB,)
    update_hint = "Update with SteelSeries GG on Windows, with the GameDAC connected by USB."

    @staticmethod
    def part_name(_pid):
        return "GameDAC"

    def recovery_version(self, cache, pid, chip):
        return folder_versions(bundle_folder(cache, pid), self.fw_bundles[pid][pid]).get(chip)

    @staticmethod
    def flash_problem(_jobs):
        found = len(gamedac_nodes())
        if found != 1:
            return f"Connect exactly one Arctis Nova Pro GameDAC while updating (found {found})."
        return None

    @staticmethod
    def flash_ready(pid):
        return hidraw_node(pid)

    @staticmethod
    def prepare_update(_device, chips):
        return chips

    @staticmethod
    def after_flash(_jobs):
        pass

    @staticmethod
    def flash_notes(_chips):
        return ["Connect the GameDAC to this PC directly with its USB cable (not through a USB hub),\n"
                "    with the headset plugged into the GameDAC.",
                "Don't unplug anything until it says it's finished (about a minute).",
                "Updating the MCU resets the GameDAC's settings (sidetone, EQ…) to their defaults."]

    @staticmethod
    def flash_jobs(cache, pid, chips, versions, folders):
        jobs = []
        for name, chip, pattern in BERENA_CHIPS:
            if name in chips:
                folder = folders.get(name) or bundle_folder(cache, pid)
                jobs.append(FlashJob(name, versions[name], firmware_file(folder, pattern, versions[name]), pid,
                                     lambda d, p, n=name, c=chip: berena_flash_chip(pid, n, c, d, p)))
        return jobs


MODELS = (Omni(), NovaProWireless(), NovaProWired())


def find_hub():
    # Each hub has a hidraw node whose report descriptor starts with Usage Page 0xFFC0
    # (06 C0 FF); that node also carries the 0x07 event collection.
    for node in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        try:
            with open(f"{node}/device/uevent") as f:
                hid_id = next(l.split("=", 1)[1] for l in f.read().splitlines() if l.startswith("HID_ID="))
            _bus, vid, pid = (int(x, 16) for x in hid_id.split(":"))
            model = next((m for m in MODELS if vid == VENDOR and pid in m.pids), None)
            if not model:
                continue
            with open(f"{node}/device/report_descriptor", "rb") as f:
                if f.read(3) == b"\x06\xc0\xff":
                    return "/dev/" + os.path.basename(node), model, usb_product(node), pid
        except (OSError, StopIteration, ValueError):
            continue
    return None


def usb_product(hidraw_node):
    # Walk up from the HID device to the USB device, which holds the product string
    # that PipeWire's ALSA sink name is built from.
    path = os.path.realpath(f"{hidraw_node}/device")
    while path != "/":
        try:
            with open(f"{path}/product") as f:
                return f.read().strip()
        except OSError:
            path = os.path.dirname(path)
    return None


# The open lock file while this process is updating firmware (an flock, so it's released
# even if the updater dies).
_flash_lock_fd = None


def acquire_flash_lock():
    global _flash_lock_fd
    os.makedirs(STATE_DIR, exist_ok=True)
    fd = os.open(FLASH_LOCK, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        return False
    _flash_lock_fd = fd
    return True


def release_flash_lock():
    global _flash_lock_fd
    if _flash_lock_fd is not None:
        os.close(_flash_lock_fd)
        _flash_lock_fd = None


def flash_lock_holder():
    # True if another process is writing firmware.
    if _flash_lock_fd is not None:
        return False
    try:
        fd = os.open(FLASH_LOCK, os.O_RDWR)
    except OSError:
        return False
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return False
    except BlockingIOError:
        return True
    finally:
        os.close(fd)


class Hub:
    def __init__(self):
        if flash_lock_holder():
            sys.exit("A firmware update is in progress; try again when it has finished")
        found = find_hub()
        if not found:
            sys.exit("No supported SteelSeries base station found "
                     "(Arctis Nova Pro Omni, Nova Pro Wireless or Nova Pro)")
        self.path, self.model, self.product, self.pid = found
        try:
            self.fd = os.open(self.path, os.O_RDWR)
        except PermissionError:
            sys.exit(f"No permission to open {self.path} ({self.model.name}); "
                     "install the udev rule (./install.sh) and replug the device")

    def send(self, *payload):
        os.write(self.fd, bytes([self.model.report, *payload]) + bytes(63 - len(payload)))

    def read(self, timeout):
        if not select.select([self.fd], [], [], timeout)[0]:
            return None
        return os.read(self.fd, 64)

    def query(self, cmd, attempts=3):
        # Event reports are interleaved on the same collection, so skip until our reply.
        for _ in range(attempts):
            self.send(cmd)
            deadline = time.time() + 2
            while time.time() < deadline:
                d = self.read(deadline - time.time())
                if d and d[0] == self.model.report and d[1] == cmd:
                    return d
        sys.exit(f"no reply to command {cmd:#04x}")

    def settings(self):
        return self.model.settings(self)

    def close(self):
        os.close(self.fd)


def cmd_status(hub, args):
    m = hub.model
    a = hub.settings()
    if m.wireless:
        s = hub.query(CMD_STATUS)
        mode = {v: k for k, v in ANC_MODES.items()}.get(s[10], s[10])

        def level(raw):
            # A base station that's still starting up reports 0xFF: unknown, not 3187%.
            return raw * 100 // m.battery_steps if raw <= m.battery_steps else None

        st = {
            "connected": s[14] == 0x08,
            "battery": level(s[6]),
            "charger_battery": level(s[7]),
            "charging": s[15] == 0x02,
            "noise_mode": mode,
            "anc_level": s[16] if m.anc_level_supported else None,
            "transparency_level": s[8],
            "mic_muted": bool(s[9]),
        }
    else:
        # Wired: the headset is there whenever the GameDAC is; nothing to report on
        # battery, noise mode or mute.
        st = dict.fromkeys(("battery", "charger_battery", "charging", "noise_mode", "anc_level",
                            "transparency_level", "mic_muted"))
        st["connected"] = True
    if args.json:
        print(json.dumps({
            "model": m.name,
            "wireless": m.wireless,
            **st,
            "anc_writable": m.anc_writable,
            "sidetone_on": a["sidetone_on"],
            "sidetone_level": a["sidetone_level"],
            "sidetone_max": m.sidetone_max,
            "mic_volume": a["mic_volume"],
            "chatmix_game": a["chatmix_game"],
            "chatmix_chat": a["chatmix_chat"],
            "firmware": firmware_summary(load_firmware_state(), hub.pid),
        }))
        return
    print(f"model:        {m.name}")
    if m.wireless:
        print(f"headset:      {'connected' if st['connected'] else 'not connected'}")
        if st["connected"] and st["battery"] is not None:
            print(f"battery:      {st['battery']}%")
        spare = "unknown" if st["charger_battery"] is None else f"{st['charger_battery']}%"
        print(f"spare:        {spare}")
        levels = f"ANC level {st['anc_level']}/3, " if st["anc_level"] is not None else ""
        note = "" if m.anc_writable else "; change it on the headset"
        print(f"noise mode:   {st['noise_mode']}  ({levels}transparency level {st['transparency_level']}/10{note})")
    else:
        print("headset:      wired")
    sidetone = f"on, level {a['sidetone_level']}/{m.sidetone_max}" if a["sidetone_on"] else "off"
    print(f"sidetone:     {sidetone}")
    muted = "" if st["mic_muted"] is None else ", muted" if st["mic_muted"] else ", unmuted"
    print(f"mic:          volume {a['mic_volume']}/10{muted}")
    print(f"chatmix dial: game {a['chatmix_game']}%, chat {a['chatmix_chat']}%")


def require_anc(hub):
    if not hub.model.anc_writable:
        sys.exit(f"The {hub.model.name} has no noise cancelling or transparency mode")


def cmd_anc(hub, args):
    require_anc(hub)
    hub.send(CMD_ANC_MODE, ANC_MODES[args.mode])


def cmd_anc_level(hub, args):
    require_anc(hub)
    if not hub.model.anc_level_supported:
        sys.exit(f"The {hub.model.name} doesn't have an adjustable ANC strength")
    hub.send(CMD_ANC_LEVEL, args.level)


def cmd_transparency_level(hub, args):
    require_anc(hub)
    hub.send(CMD_TRANSPARENT_LEVEL, args.level)


def cmd_mic_volume(hub, args):
    hub.send(CMD_MIC_VOLUME, args.level)


def cmd_sidetone(hub, args):
    m = hub.model
    current = hub.settings()
    if args.value == "off":
        level = 0
    elif args.value == "on":
        level = m.default_sidetone(current) or 1
    else:
        level = int(args.value) if args.value.isdigit() else 0
        if not 1 <= level <= m.sidetone_max:
            sys.exit(f"sidetone level must be 1-{m.sidetone_max}, on or off for the {m.name}")
    m.set_sidetone(hub, level, current)


def set_volume(sink, percent):
    result = subprocess.run(["pactl", "set-sink-volume", sink, f"{percent}%"],
                            check=False, capture_output=True)
    return result.returncode == 0


def list_sinks():
    try:
        out = subprocess.run(["pactl", "list", "short", "sinks"], check=True,
                             capture_output=True, text=True).stdout
    except (OSError, subprocess.CalledProcessError):
        return []
    return [line.split("\t")[1] for line in out.splitlines() if len(line.split("\t")) > 1]


def find_sink(product):
    # The connected headset's ALSA sink. Its name changes with the card profile (e.g.
    # analog-stereo vs. pro-output-0), so callers re-check it rather than caching it.
    if not product:
        return None
    # The trailing "-" keeps "Arctis Nova Pro" from matching "Arctis Nova Pro Wireless/Omni".
    prefix = "alsa_output.usb-SteelSeries_" + product.replace(" ", "_") + "-"
    return next((name for name in list_sinks() if name.startswith(prefix)), None)


def output_override():
    try:
        with open(OUTPUT_STATE) as f:
            return f.read().strip() or None
    except OSError:
        return None


def desired_target(product):
    # The chosen output if it exists right now, otherwise the headset.
    override = output_override()
    if override and override in list_sinks():
        return override
    return find_sink(product)


def loopback_routing():
    # {loopback output name: (node id, current target.object)} from PipeWire's "default"
    # metadata, or None if the loopbacks aren't up.
    try:
        dump = json.loads(subprocess.run(["pw-dump"], check=True, capture_output=True,
                                         text=True).stdout)
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError):
        return None
    ids = {o["info"]["props"].get("node.name"): o["id"] for o in dump
           if o.get("type") == "PipeWire:Interface:Node" and o.get("info")}
    if not all(name in ids for name in LOOPBACK_OUTPUTS):
        return None
    targets = {}
    for o in dump:
        if o.get("type") == "PipeWire:Interface:Metadata" and o.get("props", {}).get("metadata.name") == "default":
            for entry in o.get("metadata") or []:
                if entry.get("key") == "target.object":
                    targets[entry.get("subject")] = entry.get("value")
    return {name: (ids[name], targets.get(ids[name])) for name in LOOPBACK_OUTPUTS}


def route_outputs(target):
    # Point the Game/Chat loopbacks at this sink via PipeWire's routing metadata, so the
    # same sinks follow whichever headset (or chosen output) is in use.
    routing = loopback_routing()
    if routing is None:
        return False
    for node_id, _current in routing.values():
        result = subprocess.run(["pw-metadata", "-n", "default", str(node_id), "target.object", target],
                                check=False, capture_output=True)
        if result.returncode != 0:
            return False
    return True


def reconcile_routing(product):
    # Compare PipeWire's actual routing with the desired target and fix it if they differ.
    # Reading the real state (rather than remembering what was last routed) also catches
    # changes made by `arctis-omni output` or lost on a PipeWire restart. True when settled.
    target = desired_target(product)
    if not target:
        return False
    routing = loopback_routing()
    if routing is None:
        return False
    if all(current == target for _node_id, current in routing.values()):
        return True
    if route_outputs(target):
        print(f"game/chat outputs routed to {target}", flush=True)
        return True
    return False


def valid_mix(game, chat):
    # A real dial position always has one side at 100 (100/100 is the centre). A hub that
    # has just connected reports 0/0 until it has finished starting up.
    return max(game, chat) == 100


def cmd_chatmix_daemon(_hub, _args):
    # Puts the hub in software-ChatMix mode and tells it a mixer ("Sonar") is present, as
    # GG does while Sonar runs, then mirrors the dial onto the Game/Chat loopback sinks.
    # Reconnects if the hub goes away; clears both flags on exit, as GG does on shutdown.
    stop = False

    def on_signal(*_):
        nonlocal stop
        stop = True

    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)
    while not stop:
        if flash_lock_holder():
            time.sleep(3)
            continue
        if not find_hub():
            # No headset to fall back to, but a saved output (e.g. speakers) still needs
            # routing after PipeWire recreates the loopbacks.
            if output_override():
                reconcile_routing(None)
            time.sleep(3)
            continue
        hub = None
        try:
            hub = Hub()
            for _ in range(HUB_INIT_SECONDS * 10):
                if stop:
                    break
                time.sleep(0.1)
            # Omni firmware 1.32 only lets its knob enter ChatMix mode after the flags are
            # cleared and then set software ChatMix first, Sonar present second; sent in
            # the other order the Sonar icon shows but the knob stays on volume. (Verified on
            # the Omni at 1.32; the Nova Pro models were verified with the old order.)
            for cmd, value in ((CMD_SOFTWARE_CHATMIX, 0), (CMD_SONAR_PRESENT, 0),
                               (CMD_SOFTWARE_CHATMIX, 1), (CMD_SONAR_PRESENT, 1)):
                hub.send(cmd, value)
                time.sleep(0.3)
            print(f"chatmix active on {hub.path} ({hub.model.name})", flush=True)
            # The dial position, routing and volumes are retried every second until they
            # succeed (hub still starting up, sinks not up yet, PipeWire restarting). Until
            # the dial position is known the volumes are left alone rather than zeroed.
            mix = None
            applied = False
            next_route_check = 0.0
            while not stop:
                if mix is None:
                    a = hub.settings()
                    if valid_mix(a["chatmix_game"], a["chatmix_chat"]):
                        mix = (a["chatmix_game"], a["chatmix_chat"])
                        applied = False
                        print(f"dial at game {mix[0]}% chat {mix[1]}%", flush=True)
                if time.monotonic() >= next_route_check:
                    # Retry every second until routed, then re-check every 10 s in case the
                    # sink was renamed (card profile change) or the output was switched.
                    settled = reconcile_routing(hub.product)
                    next_route_check = time.monotonic() + (10 if settled else 1)
                if mix is not None and not applied:
                    applied = set_volume(GAME_SINK, mix[0]) & set_volume(CHAT_SINK, mix[1])
                d = hub.read(1.0)
                if d and d[0] == EVENT and d[1] == EV_CHATMIX and valid_mix(d[2], d[3]):
                    mix = (d[2], d[3])
                    applied = False
        except OSError as e:
            print(f"hub lost ({e}), waiting for it to come back", flush=True)
            time.sleep(3)
        finally:
            if hub:
                try:
                    hub.send(CMD_SOFTWARE_CHATMIX, 0)
                    hub.send(CMD_SONAR_PRESENT, 0)
                except OSError:
                    pass
                os.close(hub.fd)


def cmd_output(_hub, args):
    # Choose where Arctis Game/Chat play: the headset, or another output such as speakers.
    # The choice is saved so the ChatMix service keeps it across restarts.
    if args.target is None:
        print(output_override() or "headset")
        return
    if args.target == "headset":
        try:
            os.remove(OUTPUT_STATE)
        except FileNotFoundError:
            pass
        found = find_hub()
        target = find_sink(found[2]) if found else None
        if not target:
            print("Output set to the headset; it will be used once it's connected")
            return
    else:
        target = args.target
        if target.startswith("arctis_omni_"):
            sys.exit("Game/Chat can't be routed into themselves; pick a real output")
        if target not in list_sinks():
            sys.exit(f"No output named {target!r}; see 'pactl list short sinks'")
        os.makedirs(os.path.dirname(OUTPUT_STATE), exist_ok=True)
        with open(OUTPUT_STATE, "w") as f:
            f.write(target + "\n")
    if not route_outputs(target):
        sys.exit("Couldn't route Game/Chat (are the Arctis Game/Chat sinks loaded?)")


# --- Firmware -----------------------------------------------------------------------

USER_AGENT = {"User-Agent": f"arctis-omni/{VERSION}"}


def parse_version(raw):
    # Version fields come padded in different styles ("02.04.00", "0.3.82", NUL-filled);
    # an all-zero field means the part isn't there (e.g. headset not paired).
    text = raw.strip(b"\0").decode("ascii", "replace").strip()
    parts = text.split(".")
    if len(parts) < 2 or not all(p.isdigit() for p in parts):
        return None
    numbers = [int(p) for p in parts]
    return ".".join(map(str, numbers)) if any(numbers) else None


def version_key(version):
    return tuple(int(p) for p in version.split("."))


def device_versions(hub):
    reply = hub.query(0x10)
    return {chip: parse_version(reply[2 + 12 * i:14 + 12 * i])
            for i, chip in enumerate(hub.model.fw_chips)}


def gg_latest():
    # (version, installer URL, installer MD5) of the latest GG release.
    version, latest = GG_BASELINE, None
    for _hop in range(10):
        query = urllib.parse.urlencode({"current_version": version, "platform": "windows"})
        request = urllib.request.Request(f"{GG_CHECK_URL}?{query}", headers=USER_AGENT)
        with urllib.request.urlopen(request, timeout=30) as response:
            body = response.read()
        if not body.strip():
            break
        info = json.loads(body)
        if version_key(info["version"]) <= version_key(version):
            break
        version, latest = info["version"], info
    if latest is None:
        raise RuntimeError("SteelSeries' update server didn't report a GG release")
    url = latest["installer_url"]
    if not re.fullmatch(r"https://[a-z0-9.-]+\.steelseriescdn\.com/SteelSeriesGG[0-9.]+Setup\.exe", url):
        raise RuntimeError(f"Unexpected GG download link: {url}")
    md5 = str(latest.get("checksum", "")).lower()
    if not re.fullmatch(r"[0-9a-f]{32}", md5):
        raise RuntimeError("SteelSeries' update server sent no installer checksum")
    return version, url, md5


def bundle_folder(cache, pid):
    return os.path.join(cache, "firmware", str((VENDOR << 16) | pid))


def folder_pid(folder):
    # GG names firmware folders after the device: (vendor << 16) | PID, in decimal.
    try:
        return int(os.path.basename(folder)) & 0xFFFF
    except ValueError:
        return 0


def fetch_gg_firmware(version, url, md5, log):
    # Unpack only the firmware folders of supported devices from a GG release, once.
    cache = os.path.join(CACHE_DIR, f"gg-{version}")
    try:
        with open(os.path.join(cache, "format")) as f:
            if f.read().strip() == CACHE_FORMAT and os.path.isdir(os.path.join(cache, "firmware")):
                return cache
    except OSError:
        pass
    # An outdated cache stays usable (e.g. for recovering a GameDAC offline) until its
    # replacement is fully unpacked.
    if not shutil.which("7z"):
        raise RuntimeError("7z is needed to unpack SteelSeries GG; install 7zip")
    os.makedirs(CACHE_DIR, exist_ok=True)
    pids = {pid for m in MODELS for folders in m.fw_bundles.values() for pid in folders}
    pids |= {pid for m in MODELS for pid in getattr(m, "fw_v2_headset", {}).values()}
    with tempfile.TemporaryDirectory(dir=CACHE_DIR) as tmp:
        installer = os.path.join(tmp, "gg.exe")
        log(f"Downloading SteelSeries GG {version} to read the firmware in it (about 400 MB)…")
        digest = hashlib.md5()
        with urllib.request.urlopen(urllib.request.Request(url, headers=USER_AGENT), timeout=60) as response, \
                open(installer, "wb") as f:
            while chunk := response.read(1 << 20):
                digest.update(chunk)
                f.write(chunk)
        if digest.hexdigest() != md5:
            raise RuntimeError(f"GG {version} download is corrupt (checksum mismatch); try again")
        subprocess.run(["7z", "x", "-y", "-bso0", "-bsp0", f"-o{tmp}/x", installer,
                        "apps/engine/firmware/*"], check=True)
        staged = os.path.join(tmp, "staged")
        for pid in pids:
            src = bundle_folder(os.path.join(tmp, "x", "apps", "engine"), pid)
            if os.path.isdir(src):
                shutil.copytree(src, bundle_folder(staged, pid))
        os.makedirs(cache, exist_ok=True)
        current = os.path.join(cache, "firmware")
        if os.path.isdir(current):
            os.replace(current, os.path.join(tmp, "previous"))  # removed with tmp
        os.replace(os.path.join(staged, "firmware"), current)
        with open(os.path.join(cache, "format"), "w") as f:
            f.write(CACHE_FORMAT + "\n")
    prune_caches(keep=cache)
    return cache


def prune_caches(keep):
    # Remove older GG releases, unless an updater may still be reading one.
    if flash_lock_holder():
        return
    for old in glob.glob(os.path.join(CACHE_DIR, "gg-*")):
        if old != keep:
            shutil.rmtree(old, ignore_errors=True)


def bundle_versions(cache, model, pid):
    # {chip: (version, folder)} that GG ships for this device.
    out = {}
    for folder_pid, chips in model.fw_bundles.get(pid, {}).items():
        folder = bundle_folder(cache, folder_pid)
        try:
            with open(os.path.join(folder, "version.json")) as f:
                versions = json.load(f)["firmware_version"].split("/")
        except (OSError, ValueError, KeyError):
            continue
        for chip, version in zip(chips, versions):
            out[chip] = (version, folder)
    return out


def load_firmware_state():
    try:
        with open(FIRMWARE_STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_firmware_state(state):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = FIRMWARE_STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f, indent=1)
    os.replace(tmp, FIRMWARE_STATE)


def compare_device(state, hub):
    # Record the connected device's firmware against the cached GG release.
    current = device_versions(hub)
    bundle = bundle_versions(state["cache"], hub.model, hub.pid) if state.get("cache") else {}
    v2 = getattr(hub.model, "fw_v2_headset", {}).get(hub.pid)
    headset = current.get("headset MCU")
    if v2 and headset and version_key(headset)[0] >= 2 and state.get("cache"):
        folder = bundle_folder(state["cache"], v2)
        try:
            with open(os.path.join(folder, "version.json")) as f:
                versions = json.load(f)["firmware_version"].split("/")
            bundle.update({chip: (version, folder)
                           for chip, version in zip(("headset MCU", "headset Bluetooth"), versions)})
        except (OSError, ValueError, KeyError):
            pass
    available = {chip: version for chip, (version, _folder) in bundle.items()}
    folders = {chip: folder for chip, (_version, folder) in bundle.items()}
    updates = {chip: version for chip, version in available.items()
               if current.get(chip) and version_key(version) > version_key(current[chip])}
    state["device"] = {
        "model": hub.model.name,
        "pid": f"{hub.pid:04x}",
        "current": current,
        "available": available,
        "updates": updates,
        "folders": folders,
        "flashable": hub.pid in hub.model.flashable,
    }
    return state


def firmware_check(log=print):
    version, url, md5 = gg_latest()
    state = load_firmware_state()
    state.update(gg_version=version, checked=time.strftime("%Y-%m-%d %H:%M"),
                 cache=fetch_gg_firmware(version, url, md5, log))
    if find_hub():
        hub = Hub()
        try:
            compare_device(state, hub)
        finally:
            hub.close()
    save_firmware_state(state)
    return state


def firmware_summary(state, pid):
    # The part of the saved check that belongs to this device, for `status --json`.
    device = state.get("device")
    if not device or device.get("pid") != f"{pid:04x}":
        return None
    return {"update_available": bool(device["updates"]), "updates": device["updates"],
            "current": device["current"], "flashable": device["flashable"],
            "gg_version": state.get("gg_version"), "checked": state.get("checked")}


def notify_update(state):
    device = state.get("device") or {}
    if not device.get("updates"):
        return
    key = f"{device['pid']}:{sorted(device['updates'].items())}"
    if state.get("notified") == key:
        return
    chips = ", ".join(f"{chip} {device['current'][chip]} → {v}" for chip, v in device["updates"].items())
    # Stays until dismissed: a default popup is gone after a few seconds and easy to miss.
    subprocess.run(["notify-send", "--app-name=Arctis", "--icon=audio-headset", "--expire-time=0",
                    f"Firmware update for your {device['model']}",
                    f"{chips}\nOpen the Arctis Headset Battery widget to update."], check=False)
    state["notified"] = key
    save_firmware_state(state)


# Arctis Nova Pro (wired) GameDAC update protocol ("Berena" in GG): see the README.
BERENA_CHIPS = (("USB", 0, "_4050_"), ("DSP", 1, "_5680_"), ("MCU", 3, "_mcu_"))
BERENA_BOOT_PIDS = {0x12CB: 0x12CC}
BERENA_BLOCK = 512


def hidraw_nodes(pid):
    nodes = []
    for node in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        try:
            with open(f"{node}/device/uevent") as f:
                if f"HID_ID=0003:{VENDOR:08X}:{pid:08X}" not in f.read().upper():
                    continue
            with open(f"{node}/device/report_descriptor", "rb") as f:
                if f.read(3) == b"\x06\xc0\xff":
                    nodes.append("/dev/" + os.path.basename(node))
        except OSError:
            continue
    return nodes


def hidraw_node(pid):
    nodes = hidraw_nodes(pid)
    return nodes[0] if nodes else None


class BerenaLink:
    def __init__(self, path):
        self.fd = os.open(path, os.O_RDWR)

    def close(self):
        os.close(self.fd)

    def out(self, *payload):
        os.write(self.fd, bytes([0x06, *payload]) + bytes(63 - len(payload)))

    def block(self, chip, offset, data):
        buf = bytearray(9 + BERENA_BLOCK)
        buf[0:3] = bytes([0x06, 0xA4, chip])
        buf[3:5] = (len(data) + 4).to_bytes(2, "little")
        buf[5:9] = offset.to_bytes(4, "little")
        buf[9:9 + len(data)] = data
        fcntl.ioctl(self.fd, (3 << 30) | (len(buf) << 16) | (ord("H") << 8) | 0x06, buf)  # HIDIOCSFEATURE

    def ack(self, what):
        for _ in range(15):
            if not select.select([self.fd], [], [], 10)[0]:
                break
            reply = os.read(self.fd, 64)
            if reply[0] != 0x06:
                continue  # event reports share the interface
            if reply[2] == 0x5A:  # 'Z'
                return
            raise RuntimeError(f"{what}: the device answered {reply[:6].hex(' ')}")
        raise RuntimeError(f"{what}: no answer from the device")


def berena_flash_chip(app_pid, chip_name, chip, data, progress):
    boot_pid = BERENA_BOOT_PIDS[app_pid]
    path = hidraw_node(app_pid) or hidraw_node(boot_pid)
    if not path:
        raise RuntimeError("the GameDAC isn't connected")
    link = BerenaLink(path)
    try:
        if path == hidraw_node(app_pid):
            link.out(0x02, chip)
            if chip == 0:
                # The USB chip is updated from the bootloader, which re-enumerates.
                link.close()
                link = None
                time.sleep(1)
                deadline = time.time() + 20
                while not (boot := hidraw_node(boot_pid)):
                    if time.time() > deadline:
                        raise RuntimeError("the GameDAC's bootloader didn't appear")
                    time.sleep(0.1)
                time.sleep(1)
                link = BerenaLink(boot)
            else:
                link.ack("enter update mode")
                time.sleep(1)
        link.out(0xA2, chip)
        time.sleep(1)
        link.ack("start")
        count = len(data) // BERENA_BLOCK if chip == 0 else -(-len(data) // BERENA_BLOCK)
        blocks = [(i * BERENA_BLOCK, data[i * BERENA_BLOCK:(i + 1) * BERENA_BLOCK]) for i in range(count)]
        if chip in (1, 2):
            blocks = [(o, d) for o, d in blocks if d != b"\xff" * len(d)]  # blank DSP blocks
        for n, (offset, chunk) in enumerate(blocks, 1):
            link.block(chip, offset, chunk)
            link.ack(f"{chip_name} block at {offset:#x}")
            progress(chip_name, n, len(blocks))
        time.sleep(1)
        link.out(0xA8, chip, 0, 0)
        if chip != 0:
            link.ack(f"{chip_name} finish")
        time.sleep(1)
    except BaseException:
        if link:
            try:
                link.out(0xA8, chip)  # GG reboots the chip when an update fails
            except OSError:
                pass
        raise
    finally:
        if link:
            link.close()


# Arctis Nova Pro Wireless update protocol: see the README. App PID → bootloader PID, for
# the base stations and for the headsets (which are updated over their own USB cable).
NPW_BOOT_PIDS = {0x12E0: 0x12E1, 0x12E5: 0x12E7, 0x225D: 0x225F,
                 0x12E2: 0x12E3, 0x12E8: 0x12E9, 0x2240: 0x2241, 0x2242: 0x2243, 0x2260: 0x2261}
NPW_BASE_PIDS = (0x12E0, 0x12E5, 0x225D)
NPW_MCU_BLOCK = 1012
NPW_DSP_BLOCK = 512
NPW_QCC_CHUNK = 0xF4


def debug(*args):
    if os.environ.get("ARCTIS_OMNI_DEBUG"):
        say("\n  [debug]", *args)


def vendor_nodes(pid, report):
    # hidraw nodes of a device whose vendor-defined collection carries this report ID.
    nodes = []
    for node in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        try:
            with open(f"{node}/device/uevent") as f:
                if f"HID_ID=0003:{VENDOR:08X}:{pid:08X}" not in f.read().upper():
                    continue
            with open(f"{node}/device/report_descriptor", "rb") as f:
                desc = f.read()
        except OSError:
            continue
        if desc[:1] == b"\x06" and desc[2:3] == b"\xff" and bytes([0x85, report]) in desc:
            nodes.append("/dev/" + os.path.basename(node))
    return nodes


def wait_for_node(pid, report, timeout):
    deadline = time.time() + timeout
    while not (nodes := vendor_nodes(pid, report)):
        if time.time() > deadline:
            return None
        time.sleep(0.05)
    return nodes[0]


class HidLink:
    def __init__(self, path, report):
        # udev hands the node to the logged-in user a moment after it appears.
        deadline = time.time() + 5
        while True:
            try:
                self.fd = os.open(path, os.O_RDWR)
                break
            except (PermissionError, FileNotFoundError):
                if time.time() > deadline:
                    raise RuntimeError(f"can't open {path}; install the udev rule (./install.sh)")
                time.sleep(0.05)
        self.report = report

    def close(self):
        os.close(self.fd)

    def out(self, *payload):
        os.write(self.fd, bytes([self.report, *payload]).ljust(64, b"\0"))

    def feature(self, payload, size):
        buf = bytearray(bytes([self.report, *payload]).ljust(size, b"\0"))
        fcntl.ioctl(self.fd, (3 << 30) | (size << 16) | (ord("H") << 8) | 0x06, buf)  # HIDIOCSFEATURE

    def read(self, timeout):
        if not select.select([self.fd], [], [], max(0, timeout))[0]:
            return None
        reply = os.read(self.fd, 64)
        debug("<", reply[:8].hex(" "))
        return reply

    def pending(self):
        replies = []
        while (reply := self.read(0)) is not None:
            replies.append(reply)
        return replies

    def reply(self, key, timeout, what):
        # The next report starting with `key` (report ID and command bytes); event
        # reports on the same interface are skipped.
        deadline = time.time() + timeout
        while (reply := self.read(deadline - time.time())) is not None:
            if reply.startswith(bytes(key)):
                return reply
        raise RuntimeError(f"{what}: no answer")

    def command(self, payload, expect, timeout, what):
        self.out(*payload)
        expect = bytes(expect)
        reply = self.reply(expect[:3], timeout, what)
        if not reply.startswith(expect):
            raise RuntimeError(f"{what}: the device answered {reply[:6].hex(' ')}")
        return reply


def parse_intel_hex(data):
    # [(address, bytes)] like GG builds them: a record extends the current region when it
    # continues where the last one ended, otherwise it starts a new one.
    regions, base, start, end, finished = {}, 0, None, None, False
    for number, line in enumerate(data.decode("ascii").splitlines(), 1):
        line = line.strip()
        if not line:
            continue
        rec = bytes.fromhex(line[1:]) if line.startswith(":") else b""
        if len(rec) < 5 or len(rec) != rec[0] + 5 or sum(rec) & 0xFF:
            raise RuntimeError(f"firmware file: bad record on line {number}")
        kind, payload = rec[3], rec[4:-1]
        if kind == 0:
            address = base + int.from_bytes(rec[1:3], "big")
            if start is None or address != end:
                if address in regions:
                    raise RuntimeError(f"firmware file: data at {address:#x} appears twice")
                start = address
                regions[start] = bytearray()
            regions[start] += payload
            end = address + len(payload)
        elif kind == 1:
            finished = True
            break
        elif kind == 2:
            base = int.from_bytes(payload, "big") << 4
        elif kind == 4:
            base = int.from_bytes(payload, "big") << 16
    if not finished:
        raise RuntimeError("firmware file is truncated (no end-of-file record)")
    out = sorted(regions.items())
    if not out or any(a + len(d) > b for (a, d), (b, _) in zip(out, out[1:])):
        raise RuntimeError("firmware file: no data or overlapping data")
    return out


def parse_qcc_upgrade(data):
    # Qualcomm upgrade file: an APPUHDR5 header, PARTDATA records (SQIF, partition number,
    # first word, data) and an APPUPFTR footer (the image signature).
    parts, footer, header, pos = [], None, None, 0
    while pos < len(data):
        tag, size = data[pos:pos + 8], int.from_bytes(data[pos + 8:pos + 12], "big")
        body = data[pos + 12:pos + 12 + size]
        if len(body) != size:
            raise RuntimeError("firmware file is truncated")
        if tag == b"APPUHDR5":
            header = body
        elif tag == b"PARTDATA" and size >= 8:
            parts.append((int.from_bytes(body[2:4], "big"), body[4:8], body[8:]))
        elif tag == b"APPUPFTR":
            footer = body
        else:
            raise RuntimeError(f"firmware file: unexpected {tag!r} record")
        pos += 12 + size
    if header is None or not parts or not footer:
        raise RuntimeError("not a Qualcomm upgrade file")
    return parts, footer


def xor(data):
    x = 0
    for b in data:
        x ^= b
    return x


def npw_flash_dsp(app_pid, data, progress, name):
    blocks = [(o, data[o:o + NPW_DSP_BLOCK]) for o in range(0, len(data), NPW_DSP_BLOCK)]
    blocks = [(o, d) for o, d in blocks if d != b"\xff" * len(d)]  # blank space isn't sent
    node = next(iter(vendor_nodes(app_pid, 0x06)), None)
    if not node:
        raise RuntimeError("the base station isn't connected")
    link = HidLink(node, 0x06)
    try:
        link.pending()
        link.out(0x1B, 0xF1)
        deadline = time.time() + 120
        while True:  # the DSP is ready when it reports 03
            reply = link.read(deadline - time.time())
            if reply is None:
                raise RuntimeError("the DSP didn't get ready for the update")
            if reply[0] == 0x06 and reply[3] == 0x03:
                break
        for n, (offset, chunk) in enumerate(blocks, 1):
            link.feature(bytes([0x1B, 0xF4]) + (0x70000000 + offset).to_bytes(4, "big") + chunk, 1024)
            reply = link.reply((0x06, 0xB1, 0xF3), 10, f"{name} block at {offset:#x}")
            if reply[3] != 0:
                raise RuntimeError(f"{name} block at {offset:#x}: the device answered {reply[:6].hex(' ')}")
            progress(name, n, len(blocks))
    finally:
        try:
            link.out(0x1B, 0xEE)  # ends the update, also after a failure (as GG does)
        except OSError:
            pass
        link.close()
    # That restarts the base station; wait for it before anything else talks to it.
    gone = time.time() + 5
    while vendor_nodes(app_pid, 0x06) and time.time() < gone:
        time.sleep(0.05)
    if not wait_for_node(app_pid, 0x06, 30):
        raise RuntimeError(f"the base station didn't come back after its {name} update")


def check_mcu_reply(reply, name):
    if reply[:2] == b"\x06\xa1" and reply[2] in (1, 2, 3):
        raise RuntimeError(f"{name}: the bootloader rejected a block ({reply[:4].hex(' ')})")


def npw_flash_mcu(app_pid, enter, data, progress, name):
    regions = parse_intel_hex(data)
    blocks = [(start + o, chunk[o:o + NPW_MCU_BLOCK])
              for start, chunk in regions for o in range(0, len(chunk), NPW_MCU_BLOCK)]
    boot_pid = NPW_BOOT_PIDS[app_pid]
    boot = next(iter(vendor_nodes(boot_pid, 0x06)), None)
    entered = not boot
    if entered:
        app = next(iter(vendor_nodes(app_pid, enter[0])), None)
        if not app:
            raise RuntimeError(f"the device for the {name} isn't connected")
        link = HidLink(app, enter[0])
        try:
            link.out(*enter[1:])
        finally:
            link.close()
        boot = wait_for_node(boot_pid, 0x06, 30)
        if not boot:
            raise RuntimeError("the bootloader didn't appear")
    link = HidLink(boot, 0x06)
    try:
        if entered:
            # Without this the bootloader goes back to the old firmware after 5 s. (One
            # left in its bootloader by an interrupted update stays there anyway.)
            link.out(0xB0)
        for n, (address, block) in enumerate(blocks, 1):
            link.feature(bytes([0xA1]) + address.to_bytes(4, "big") + len(block).to_bytes(2, "big")
                         + zlib.crc32(block).to_bytes(4, "big") + block, 1024)
            # GG streams without waiting (each block is a control transfer the bootloader
            # has to accept); still stop on an error the bootloader reports.
            for reply in link.pending():
                check_mcu_reply(reply, name)
            progress(name, n, len(blocks))
        # The last answers can still be on their way; read them before leaving.
        deadline = time.time() + 1
        while (reply := link.read(deadline - time.time())) is not None:
            check_mcu_reply(reply, name)
    finally:
        try:
            link.out(0xBB)  # leave the bootloader, also after a failure (as GG does)
        except OSError:
            pass
        link.close()
    if not wait_for_node(app_pid, enter[0], 60):
        raise RuntimeError(f"the device didn't come back after its {name} update")


def npw_flash_qcc(app_pid, data, progress, name):
    parts, footer = parse_qcc_upgrade(data)
    node = next(iter(vendor_nodes(app_pid, 0x07)), None)
    if not node:
        raise RuntimeError("the headset isn't connected by USB")
    link = HidLink(node, 0x07)
    total, done = sum(len(d) for _p, _w, d in parts) + len(footer), 0

    def stream(op, payload, what):
        nonlocal done
        for o in range(0, len(payload), NPW_QCC_CHUNK):
            chunk = payload[o:o + NPW_QCC_CHUNK]
            link.feature(bytes([0x2E, len(chunk) + 4, op, len(chunk)]) + chunk + bytes([xor(chunk)]), 0xFA)
            reply = link.reply((0x07, 0xE2, op), 20, what)
            if reply[3] != 0x01:
                raise RuntimeError(f"{what}: the headset answered {reply[:6].hex(' ')}")
            done += len(chunk)
            progress(name, done, total)

    try:
        link.pending()
        link.command((0x02, 0x01), (0x07, 0xE2, 0xE5, 0x03, 0xF0), 20, "start")
        time.sleep(5)
        link.command((0x2E, 0x02, 0xF0, 0x00), (0x07, 0xE2, 0xF0, 0x01), 20, "begin")
        for part, first, payload in parts:
            link.out(0x2E, 0x08, 0xF1, part >> 8, part & 0xFF, *first)
            reply = link.reply((0x07, 0xE2, 0xF1), 5, f"partition {part}")
            if reply[3] == 0x00:
                raise RuntimeError(f"partition {part}: the headset refused it")
            if reply[3] != 0x01:
                debug(f"partition {part} skipped by the headset")  # as GG does
                done += len(payload)
                continue
            stream(0xF2, payload, f"partition {part}")
            link.command((0x2E, 0x02, 0xF3), (0x07, 0xE2, 0xF3, 0x01), 5, f"partition {part} end")
        link.command((0x2E, 0x06, 0xF8, *len(footer).to_bytes(4, "big")), (0x07, 0xE2, 0xF8, 0x01), 5,
                     "signature")
        stream(0xF9, footer, "signature")
        ids = bytes(part & 0xFF for part, _w, _d in parts)
        link.feature(bytes([0x2E, len(ids) + 4, 0xFA, len(ids)]) + ids + bytes([xor(ids)]), 0xFA)
        reply = link.reply((0x07, 0xE2, 0xFA), 5, "partition list")
        if reply[3] != 0x01:
            raise RuntimeError(f"partition list: the headset answered {reply[:6].hex(' ')}")
        say(f"\r  {name}: installing…" + " " * 20, end="", flush=True)
        link.command((0x2E, 0x02, 0xF4), (0x07, 0xE2, 0xF4, 0x01), 30, "install")
        link.command((0x2E, 0x02, 0xF5), (0x07, 0xE2, 0xF5, 0x01), 5, "commit")
        time.sleep(3)
        for _attempt in range(16):  # F0 = still busy
            link.out(0x2C, 0xE4, 0x02, 0x00)
            reply = link.reply((0x07, 0xC2, 0xE4), 5, "install status")
            if not reply.startswith(b"\x07\xc2\xe4\x03\xf0"):
                break
            time.sleep(1)
        if reply[4] == 0xF0:
            raise RuntimeError("the headset didn't finish installing the update")
        link.command((0x02, 0x01), (0x07, 0xE2, 0xE5, 0x03, 0xF0), 20, "restart")
        link.command((0x2E, 0x02, 0xF6), (0x07, 0xE2, 0xF6, 0x01), 20, "finish")
        link.command((0x2E, 0x02, 0xF7), (0x07, 0xE2, 0xF7, 0x01), 20, "finish")
        link.out(0x2C, 0xFF)
    finally:
        link.close()


def firmware_file(folder, pattern, version):
    for path in glob.glob(os.path.join(folder, "*")):
        name = os.path.basename(path)
        if pattern in name and f"_v{version}." in name:
            return path
    raise RuntimeError(f"no {pattern.strip('_')} v{version} file in {folder}")


def pause(prompt="Press Enter to close…"):
    try:
        input(prompt)
    except (EOFError, KeyboardInterrupt, OSError):
        pass


def show_versions(device):
    print(f"\n  {'part':20} {'installed':12} available")
    for chip, current in device["current"].items():
        available = device["available"].get(chip, "-")
        mark = "  ← update" if chip in device["updates"] else ""
        print(f"  {chip:20} {current or '-':12} {available}{mark}")
    print()


def say(*args, **kwargs):
    # print() that survives the terminal having been closed.
    try:
        print(*args, **kwargs)
    except OSError:
        pass


class FlashInterrupted(RuntimeError):
    pass


class FlashSignals:
    # While firmware is being written: Ctrl+C is ignored, closing the terminal lets the
    # update run to the end without output, and SIGTERM aborts it the way GG does (the
    # chip's reboot command), still releasing the lock and restarting ChatMix.
    signals = (signal.SIGINT, signal.SIGHUP, signal.SIGTERM)

    def __enter__(self):
        self.saved = {sig: signal.getsignal(sig) for sig in self.signals}
        signal.signal(signal.SIGINT, lambda *_: say("\n  (Ctrl+C is ignored while firmware is being written)"))
        signal.signal(signal.SIGHUP, self.on_hangup)
        signal.signal(signal.SIGTERM, self.on_term)
        return self

    def __exit__(self, *_exc):
        for sig, handler in self.saved.items():
            signal.signal(sig, handler)

    @staticmethod
    def on_hangup(*_):
        sys.stdout = sys.stderr = open(os.devnull, "w")

    @staticmethod
    def on_term(*_):
        raise FlashInterrupted("stopped by SIGTERM")


def folder_versions(folder, chips):
    # {chip: version} from a GG firmware folder's version.json (chips in its order).
    try:
        with open(os.path.join(folder, "version.json")) as f:
            versions = json.load(f)["firmware_version"].split("/")
    except (OSError, ValueError, KeyError):
        return {}
    return dict(zip(chips, versions))


def gamedac_nodes():
    # Command nodes of every connected GameDAC we can flash, in app or bootloader mode.
    pids = (*BERENA_BOOT_PIDS, *BERENA_BOOT_PIDS.values())
    return [node for pid in pids for node in hidraw_nodes(pid)]


def npw_base_nodes():
    return [node for pid in NPW_BASE_PIDS for node in vendor_nodes(pid, 0x06)
            + vendor_nodes(NPW_BOOT_PIDS[pid], 0x06)]


def npw_headset_nodes(pid):
    return vendor_nodes(pid, 0x07) + vendor_nodes(NPW_BOOT_PIDS[pid], 0x06)


def stuck_bootloader():
    # (model, app PID, chip) of a device sitting in its bootloader: an interrupted update.
    for app, boot in BERENA_BOOT_PIDS.items():
        if hidraw_node(boot):
            return MODELS[2], app, "USB"
    # A Nova Pro Wireless bootloader with good firmware behind it leaves by itself after
    # 5 s, so only report one that's still there after that.
    def in_bootloader():
        return [app for app, boot in NPW_BOOT_PIDS.items() if vendor_nodes(boot, 0x06)]

    if not in_bootloader():
        return None
    time.sleep(6)
    found = in_bootloader()
    if not found:
        return None
    app = found[0]
    return MODELS[1], app, "base MCU" if app in NPW_BASE_PIDS else "headset MCU"


class FlashJob:
    # One chip's update: `run(data, progress)` writes it to the device with PID `pid`.
    def __init__(self, chip, version, path, pid, run):
        self.chip, self.version, self.path, self.pid, self.run = chip, version, path, pid, run

    def load(self):
        with open(self.path, "rb") as f:
            self.data = f.read()


def read_jobs(jobs):
    # Read every image first, so a cache change can't pull a file away mid-update.
    try:
        for job in jobs:
            job.load()
    except OSError as e:
        say(f"Couldn't read the firmware files: {e}")
        return False
    return True


def run_flash(model, app_pid, jobs):
    # Write the jobs' firmware. True on success.
    problem = model.flash_problem(jobs)
    if problem:
        say(problem)
        return False
    if not read_jobs(jobs):
        return False
    if not acquire_flash_lock():
        say("Another firmware update is already running.")
        return False

    def progress(chip_name, n, total):
        say(f"\r  {chip_name}: {100 * n // total:3d}% ({n}/{total})", end="", flush=True)

    service = "arctis-omni-chatmix.service"
    was_active = False
    failed = None
    with FlashSignals():
        try:
            was_active = subprocess.run(["systemctl", "--user", "is-active", "--quiet", service]).returncode == 0
            if was_active:
                subprocess.run(["systemctl", "--user", "stop", service], check=False)
            time.sleep(2)
            for job in jobs:
                say(f"Writing {job.chip} firmware {job.version}…")
                job.run(job.data, progress)
                say(" done")
                time.sleep(2)
        except (RuntimeError, OSError) as e:
            failed = e
        finally:
            release_flash_lock()
            # Let the device finish rebooting before anything talks to it again.
            deadline = time.time() + 30
            while not model.flash_ready(app_pid) and time.time() < deadline:
                time.sleep(0.5)
            time.sleep(3)
            if was_active:
                subprocess.run(["systemctl", "--user", "start", service], check=False)
    if failed:
        say(f"\n\nThe update FAILED: {failed}")
        say("Leave everything connected and run the update again. If a part was left in its "
            "bootloader, the updater will offer to recover it.")
        return False
    return True


def refresh_device(state):
    if find_hub():
        hub = Hub()
        try:
            compare_device(state, hub)
        finally:
            hub.close()
        save_firmware_state(state)


def ask(prompt, answer):
    try:
        return input(prompt).strip() == answer
    except (EOFError, KeyboardInterrupt, OSError):
        say()
        return False


def recover(state, model, app_pid, chip):
    version = model.recovery_version(state["cache"], app_pid, chip)
    print(f"An {model.name} {model.part_name(app_pid)} is in its bootloader: a firmware update "
          "was interrupted.")
    if not version:
        print("No firmware for it in the cached SteelSeries GG release; check your connection and retry.")
        return pause()
    print(f"Re-installing its {chip} firmware ({version}) brings it back.\n")
    if not ask("Type 'recover' to start: ", "recover"):
        return print("Cancelled; nothing was changed.")
    try:
        jobs = model.flash_jobs(state["cache"], app_pid, [chip], {chip: version},
                                {chip: bundle_folder(state["cache"], app_pid)})
    except RuntimeError as e:
        print(f"Can't recover it: {e}")
        return pause()
    if not run_flash(model, app_pid, jobs):
        return pause()
    print("\nRecovered.")
    refresh_device(state)
    if state.get("device"):
        show_versions(state["device"])
        if state["device"]["updates"]:
            print("Run the update again to install the rest.")
    return pause()


def cmd_firmware_update(_args):
    print(f"Arctis firmware update (arctis-omni {VERSION})\n")
    if flash_lock_holder():
        print("Another firmware update is running; let it finish first.")
        return pause()
    try:
        state = firmware_check()
    except Exception as e:
        print(f"Couldn't check for firmware: {e}")
        # Recovering an interrupted update can still use an earlier check's files; an
        # ordinary update can't rely on an old snapshot of the installed versions.
        state = load_firmware_state()
        stuck = stuck_bootloader() if state.get("cache") else None
        if stuck:
            return recover(state, *stuck)
        return pause()

    stuck = stuck_bootloader()
    if stuck:
        return recover(state, *stuck)

    while not state.get("device") or not find_hub():
        print("Connect your headset's base station or GameDAC to this PC with its USB cable.")
        try:
            input("Press Enter when it's connected (Ctrl+C to quit)… ")
        except (EOFError, KeyboardInterrupt):
            return print()
        refresh_device(state)
    device = state["device"]
    print(f"{device['model']}, firmware from SteelSeries GG {state['gg_version']}:")
    show_versions(device)
    model = next(m for m in MODELS if m.name == device["model"])
    pid = int(device["pid"], 16)
    if not device["flashable"]:
        print("Updating this model from Linux isn't supported yet.")
        print(model.update_hint)
        return pause()
    chips = [c for c in model.fw_flash_order if c in device["updates"]]
    if not chips:
        print("Everything is up to date.")
        if not ask("Re-install the current firmware anyway? Type 'reinstall' to do so: ", "reinstall"):
            return
        # Only parts whose installed version GG ships; reinstalling never downgrades.
        chips = [c for c in model.fw_flash_order
                 if device["available"].get(c) and device["current"].get(c) == device["available"][c]]
        skipped = [c for c in model.fw_flash_order if c not in chips and device["current"].get(c)]
        if skipped:
            print(f"Leaving out {', '.join(skipped)}: the installed version isn't the one GG ships.")
    chips = model.prepare_update(device, chips)
    if not chips:
        return print("Nothing to update; nothing was changed.")
    try:
        jobs = model.flash_jobs(state["cache"], pid, chips, device["available"], device.get("folders", {}))
    except (RuntimeError, KeyError) as e:
        print(f"Can't update: {e}")
        return pause()
    print("Before starting:")
    for line in model.flash_notes(chips):
        print(f"  • {line}")
    print()
    if not ask("Type 'update' to start: ", "update"):
        return print("Cancelled; nothing was changed.")
    if not run_flash(model, pid, jobs):
        return pause()
    model.after_flash(jobs)
    refresh_device(state)
    say("\nFinished. Firmware now:")
    if state.get("device"):
        show_versions(state["device"])
    pause()


def terminal_command(cmd):
    # The desktop's configured terminal first (KDE), then common ones.
    candidates = []
    try:
        configured = subprocess.run(["kreadconfig6", "--file", "kdeglobals", "--group", "General",
                                     "--key", "TerminalApplication"], capture_output=True, text=True).stdout.strip()
        if configured:
            candidates.append(configured.split()[0])
    except OSError:
        pass
    candidates += ["xdg-terminal-exec", "konsole", "ghostty", "kitty", "alacritty", "foot",
                   "gnome-terminal", "xterm"]
    for name in candidates:
        exe = shutil.which(name)
        if not exe:
            continue
        base = os.path.basename(exe)
        if base in ("kitty", "foot", "xdg-terminal-exec"):
            return [exe, *cmd]
        if base == "gnome-terminal":
            return [exe, "--", *cmd]
        return [exe, "-e", *cmd]
    return None


def cmd_firmware(_hub, args):
    if args.action == "check":
        try:
            state = firmware_check(log=print if not args.notify else (lambda *_: None))
        except Exception as e:
            sys.exit(f"Firmware check failed: {e}")
        if args.notify:
            notify_update(state)
        device = state.get("device")
        print(f"Latest SteelSeries GG: {state['gg_version']}")
        if device:
            print(f"{device['model']}:")
            show_versions(device)
            print("Update available." if device["updates"] else "Up to date.")
        else:
            print("No supported headset connected.")
    elif args.action == "update":
        cmd_firmware_update(args)
    elif args.action == "open":
        term = terminal_command([os.path.realpath(sys.argv[0]), "firmware", "update"])
        if not term:
            sys.exit("No terminal found; run 'arctis-omni firmware update' in a terminal")
        subprocess.Popen(term, start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    p = argparse.ArgumentParser(prog="arctis-omni", description=__doc__.splitlines()[0])
    p.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    sub = p.add_subparsers(dest="command", required=True)
    s = sub.add_parser("status", help="battery, noise mode, sidetone and ChatMix state")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_status)
    s = sub.add_parser("anc", help="noise mode")
    s.add_argument("mode", choices=ANC_MODES)
    s.set_defaults(func=cmd_anc)
    s = sub.add_parser("anc-level", help="ANC strength 1-3 (Omni only)")
    s.add_argument("level", type=int, choices=range(1, 4))
    s.set_defaults(func=cmd_anc_level)
    s = sub.add_parser("transparency-level", help="transparency strength 1-10")
    s.add_argument("level", type=int, choices=range(1, 11))
    s.set_defaults(func=cmd_transparency_level)
    s = sub.add_parser("mic-volume", help="microphone level 1-10")
    s.add_argument("level", type=int, choices=range(1, 11))
    s.set_defaults(func=cmd_mic_volume)
    s = sub.add_parser("sidetone", help="on, off, or a level (Omni 1-10, Nova Pro Wireless 1-3)")
    s.add_argument("value")
    s.set_defaults(func=cmd_sidetone)
    sub.add_parser("chatmix-daemon", help="run the ChatMix dial service").set_defaults(func=cmd_chatmix_daemon)
    s = sub.add_parser("output", help="where Game/Chat play: show, 'headset', or an output's sink name")
    s.add_argument("target", nargs="?")
    s.set_defaults(func=cmd_output)
    s = sub.add_parser("firmware", help="check for, or install, firmware updates from SteelSeries GG")
    s.add_argument("action", choices=("check", "update", "open"),
                   help="check: compare with the latest GG; update: interactive updater; "
                        "open: run the updater in a terminal")
    s.add_argument("--notify", action="store_true", help="with check: desktop notification if there's an update")
    s.set_defaults(func=cmd_firmware)
    args = p.parse_args()
    needs_hub = args.command not in ("chatmix-daemon", "output", "firmware")
    args.func(Hub() if needs_hub else None, args)


if __name__ == "__main__":
    main()
